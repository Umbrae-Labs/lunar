diff --git a/cpp/rnskia/RNSkPictureExtension.h b/cpp/rnskia/RNSkPictureExtension.h
new file mode 100644
index 0000000000000000000000000000000000000000..50522ce469a82a260281cf11cfc24f3a03f24ee2
--- /dev/null
+++ b/cpp/rnskia/RNSkPictureExtension.h
@@ -0,0 +1,72 @@
+#pragma once
+
+#include <functional>
+#include <memory>
+
+#include <jsi/jsi.h>
+
+class GrDirectContext;
+class SkCanvas;
+
+namespace RNSkia {
+
+class RNSkPlatformContext;
+
+/**
+ * Native drawing attached to one Skia picture view.
+ *
+ * The view keeps its own picture and its render scheduling. An extension draws
+ * on the same canvas, render thread and GPU context, beneath the picture, so
+ * the picture can hold transient UI above what the extension presents. It is
+ * created with the view's redraw request and may call it from any thread.
+ */
+class RNSkPictureExtension {
+public:
+  virtual ~RNSkPictureExtension() = default;
+
+  /** Draws beneath the view's picture, in logical (density-independent) units. */
+  virtual void draw(SkCanvas *canvas, float width, float height,
+                    GrDirectContext *directContext) = 0;
+
+  /** True while the extension animates and needs the next frame drawn. */
+  virtual bool needsContinuousRedraw() const = 0;
+
+  /** The frame drawn by the last `draw` reached the display. */
+  virtual void framePresented() = 0;
+};
+
+using RNSkPictureExtensionFactory =
+    std::function<std::shared_ptr<RNSkPictureExtension>(
+        std::function<void()> requestRedraw)>;
+
+using RNSkBindingsInstaller = std::function<void(
+    facebook::jsi::Runtime &runtime,
+    std::shared_ptr<RNSkPlatformContext> platformContext)>;
+
+/**
+ * The extension compiled into this library, if any. The factory runs for every
+ * picture view; the installer runs on the JS thread whenever Skia installs its
+ * bindings into a runtime.
+ */
+struct RNSkPictureExtensionRegistry {
+  static RNSkPictureExtensionFactory &factory() {
+    static RNSkPictureExtensionFactory value;
+    return value;
+  }
+
+  static RNSkBindingsInstaller &bindingsInstaller() {
+    static RNSkBindingsInstaller value;
+    return value;
+  }
+};
+
+#if defined(RNSKIA_PICTURE_EXTENSION)
+/**
+ * Defined by the extension sources the build adds to this library. Called
+ * before the bindings are installed; a direct call keeps a static-library
+ * link from dropping the extension's object files.
+ */
+void registerPictureExtension();
+#endif
+
+} // namespace RNSkia
