{
  "expo": {
    "name": "lunar",
    "slug": "lunar",
    "version": "0.2.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lunar",
    "userInterfaceStyle": "automatic",
    "android": {
      "icon": "./assets/images/android-icon.png",
      "permissions": ["WRITE_SETTINGS"],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/brand-mark.png",
        "monochromeImage": "./assets/images/brand-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lunarain_079.lunar"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-light.png",
          "imageWidth": 240,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-dark.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "523fd44d-54f4-4bde-9561-e75955b19f4d"
      }
    },
    "owner": "lunarain_079"
  }
}
