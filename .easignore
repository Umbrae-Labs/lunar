# EAS uses this repository-root file instead of nested .gitignore files.
# Keep the shared rules and mobile rules in sync with both .gitignore files.
node_modules/
.husky/_/
dist/
target/
reports/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
/example/

# Build artifacts and local signing credentials
/artifacts/
/cnb-artifacts/
/*.apk
/*.aab
/credentials.json
.vscode/
/.pnpm-patches/

# The installed npm package supplies the native bridge and precompiled Rust libraries.
/rito-rn/

# Historical local build caches from the former in-tree module.
/modules/rito-rn/

# Mobile application rules, relative to the repository root.
/apps/mobile/.expo/
/apps/mobile/web-build/
/apps/mobile/**/.metro-health-check*
/apps/mobile/ios/
/apps/mobile/android/
/apps/mobile/modules/expo/*/android/build/
/apps/mobile/**/.kotlin/
/apps/mobile/credentials.json
/apps/mobile/*.apk
/apps/mobile/*.aab
/apps/mobile/example/
/apps/mobile/modules/rito-rn/
/apps/mobile/**/expo-env.d.ts
