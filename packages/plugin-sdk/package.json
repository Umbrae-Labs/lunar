{
  "name": "@umbrae-labs/lunar-plugin-sdk",
  "version": "0.1.3",
  "description": "Public contract for Lunar reader plugins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Umbrae-Labs/lunar.git",
    "directory": "packages/plugin-sdk"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui.ts",
    "./manifest": "./src/manifest.ts",
    "./package-format": "./src/package-format.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./ui": {
        "types": "./dist/ui.d.ts",
        "default": "./dist/ui.js"
      },
      "./manifest": {
        "types": "./dist/manifest.d.ts",
        "default": "./dist/manifest.js"
      },
      "./package-format": {
        "types": "./dist/package-format.d.ts",
        "default": "./dist/package-format.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "~6.0.3",
    "vitest": "3.2.4"
  }
}
