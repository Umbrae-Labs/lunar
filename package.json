{
  "name": "lunar-workspace",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "start": "pnpm --filter @lunar/mobile start",
    "android": "pnpm --filter @lunar/mobile android",
    "ios": "pnpm --filter @lunar/mobile ios",
    "web": "pnpm --filter @lunar/mobile web",
    "assets:brand": "pnpm --filter @lunar/mobile assets:brand",
    "reset-project": "pnpm --filter @lunar/mobile reset-project",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:watch": "pnpm --filter @lunar/mobile test:watch",
    "check": "pnpm -r --if-present run check",
    "check:expo": "pnpm --filter @lunar/mobile check:expo",
    "styles:generate": "pnpm --filter @lunar/mobile styles:generate",
    "perf:reader": "node scripts/reader-perf-report.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9"
  },
  "lint-staged": {
    "apps/mobile/src/**/*.{js,jsx,ts,tsx}": [
      "pnpm --filter @lunar/mobile exec eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "apps/mobile/src/**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 120,
    "bracketSameLine": true
  }
}
