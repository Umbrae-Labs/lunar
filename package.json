    "sharp": "^0.35.4",
    "typescript": "~6.0.3",
    "vite": "7.2.4",
    "vitest": "3.2.4"
  },
  "scripts": {
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "eas-build-pre-install": "bash scripts/eas-install-rito-toolchain.sh",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "perf:reader": "node scripts/reader-perf-report.mjs",
    "prepare": "husky",
    "styles:generate": "uniwind generate-artifacts --css ./src/global.css --dts ./src/uniwind-types.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run test && pnpm run lint",
    "check:expo": "expo install --check"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules/expo"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "src/**/*.{json,css,md}": "prettier --write"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 120,
    "bracketSameLine": true
  },
  "private": true
}
